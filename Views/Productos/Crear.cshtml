@model PCHIAPAS.Models.ProductoRegistroViewModel

@{
    ViewData["Title"] = "Registrar producto";
}

<h1 class="titulo-pagina">Registrar producto</h1>

<p class="text-muted">
    Ingresa los datos de la computadora que deseas agregar.
</p>

<div class="card p-4 mt-3">

    <form asp-controller="Productos" asp-action="Crear" method="post">

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row g-3">

            <div class="col-md-6">
                <label asp-for="Nombre" class="form-label">
                    Nombre del producto
                </label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Procesador" class="form-label">
                    Procesador
                </label>
                <input asp-for="Procesador" class="form-control" />
                <span asp-validation-for="Procesador" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Ram" class="form-label">
                    Memoria RAM
                </label>
                <input asp-for="Ram" class="form-control" />
                <span asp-validation-for="Ram" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="TarjetaGrafica" class="form-label">
                    Tarjeta gráfica
                </label>
                <input asp-for="TarjetaGrafica" class="form-control" />
                <span asp-validation-for="TarjetaGrafica" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Almacenamiento" class="form-label">
                    Almacenamiento
                </label>
                <input asp-for="Almacenamiento" class="form-control" />
                <span asp-validation-for="Almacenamiento" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="Precio" class="form-label">
                    Precio
                </label>
                <input asp-for="Precio" type="number" step="0.01" min="0.01" class="form-control" />
                <span asp-validation-for="Precio" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="Existencia" class="form-label">
                    Existencia
                </label>
                <input asp-for="Existencia" type="number" min="0" class="form-control" />
                <span asp-validation-for="Existencia" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="IdMarca" class="form-label">
                    Marca
                </label>
                <select asp-for="IdMarca" asp-items="Model.Marcas" class="form-select">
                    <option value="0">Selecciona una marca</option>
                </select>
                <span asp-validation-for="IdMarca" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="IdCategoria" class="form-label">
                    Categoría
                </label>
                <select asp-for="IdCategoria" asp-items="Model.Categorias" class="form-select">
                    <option value="0">Selecciona una categoría</option>
                </select>
                <span asp-validation-for="IdCategoria" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="Imagen" class="form-label">
                    Ruta de la imagen
                </label>
                <input asp-for="Imagen" class="form-control" placeholder="/imagenes/PC-Nueva.jpg" />
                <span asp-validation-for="Imagen" class="text-danger"></span>
                <small class="text-muted">
                    Coloca primero la imagen en wwwroot/imagenes.
                </small>
            </div>

        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">
                Guardar producto
            </button>

            <a asp-controller="Inventario" asp-action="Index" class="btn btn-secondary">
                Cancelar
            </a>
        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
