@model IEnumerable<PCHIAPAS.Models.Producto>

@{
    ViewData["Title"] = "Inventario";
}

<h1 class="titulo-pagina">Inventario</h1>

<p class="text-muted">
    Lista de productos registrados en PCHIAPAS.
</p>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success">
        @mensaje
    </div>
}

<a asp-controller="Productos" asp-action="Crear" class="btn btn-primary mb-3">
    Registrar producto
</a>

<div class="table-responsive">

    <table class="table table-bordered table-striped align-middle mt-3">

        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Producto</th>
                <th>Existencia</th>
                <th>Estado</th>
            </tr>
        </thead>

        <tbody>

            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-center">
                        No hay productos registrados.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var producto in Model)
                {
                    <tr>
                        <td>@producto.IdProducto</td>

                        <td>@producto.Nombre</td>

                        <td>@producto.Existencia</td>

                        <td>
                            @if (producto.Existencia > 0)
                            {
                                <span class="badge bg-success">
                                    Disponible
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Agotado
                                </span>
                            }
                        </td>
                    </tr>
                }
            }

        </tbody>

    </table>

</div>
