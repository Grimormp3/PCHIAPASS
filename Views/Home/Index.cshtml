@{
    ViewData["Title"] = "Inicio";
}

<section class="bienvenida rounded-3 p-4 p-md-5 mb-4">
    <div class="row align-items-center g-4">
        <div class="col-md-7">
            <p class="text-uppercase subtitulo mb-2">Tienda de computadoras en Chiapas</p>
            <h1 class="fw-bold">Bienvenido a PCHIAPAS</h1>
            <p class="mt-3">
                Somos una tienda dedicada a la venta de computadoras armadas
                para videojuegos, trabajos de oficina y actividades escolares.
            </p>
            <a asp-controller="Productos" asp-action="Index" class="btn btn-primary mt-2">Ver catálogo</a>
        </div>
        <div class="col-md-5">
            <img class="img-fluid foto-principal rounded-3"
                 src="https://images.unsplash.com/photo-1597872200969-2b65d56bd16b?auto=format&amp;fit=crop&amp;w=900&amp;q=80"
                 onerror="this.onerror=null;this.src='/imagenes/pc-gamer.svg';"
                 alt="Computadora gamer con iluminación" />
        </div>
    </div>
</section>

<h2 class="titulo-seccion">Nuestros equipos</h2>
<p class="text-muted">Estas son algunas opciones que podrías encontrar en nuestra tienda.</p>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card tarjeta-producto h-100">
            <img src="/imagenes/PC-Oficina.jpg" class="producto-imagen"
                 alt="Ilustración de una computadora para oficina" />
            <div class="card-body">
                <h5 class="card-title">PC para oficina</h5>
                <p class="card-text">Ideal para tareas, clases y trabajo de oficina.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card tarjeta-producto h-100">
            <img src="/imagenes/PC-Gamer.jpg" class="producto-imagen" alt="Ilustración de computadora gamer" />
            <div class="card-body">
                <h5 class="card-title">PC Gamer</h5>
                <p class="card-text">Equipos para disfrutar distintos videojuegos.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card tarjeta-producto h-100">
            <img src="/imagenes/PC-Pro.jpg" class="producto-imagen" alt="Ilustración de computadora avanzada" />
            <div class="card-body">
                <h5 class="card-title">PC de alto rendimiento</h5>
                <p class="card-text">Pensada para programas y tareas más exigentes.</p>
            </div>
        </div>
    </div>
</div>
